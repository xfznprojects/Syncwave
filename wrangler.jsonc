{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syncwave",
  "account_id": "29aec21336cf76706b94246af7c96cd1",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/.netlify/functions/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syncwave",
      "database_id": "65215aa0-8745-41f9-81c9-d68f7fa8c040",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNELS",
        "class_name": "RoomChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomChannel"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
