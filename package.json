{
  "name": "syncwave",
  "version": "1.0.0",
  "description": "SyncWave — Audius Social Listening Room. Listen to music together in perfect sync.",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply syncwave --local",
    "db:remote": "wrangler d1 migrations apply syncwave --remote",
    "db:setup": "node scripts/cloudflare.mjs setup",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "wrangler": "^4.149.0"
  }
}
