# SyncWave Environment Variables
# Copy to .env for frontend builds, or set public keys in your build environment.

# Audius API Key (get from https://audius.co/settings/developer-apps)
AUDIUS_API_KEY=

# Set AUDIUS_API_KEY and AUDIUS_BEARER_TOKEN separately as Worker secrets.
# For local Worker development, use .dev.vars (see .dev.vars.example).
